{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:slug/lopssimulator", "destination": "/verktoy/lopssimulator.html" },
    { "source": "/:slug/arrangementskalkulator", "destination": "/verktoy/arrangementskalkulator.html" },
    { "source": "/:slug/arenarigg", "destination": "/verktoy/arenarigg.html" },
    { "source": "/:slug([a-z0-9][a-z0-9-]{1,40})", "destination": "/arrangement.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/((?!$).+)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
